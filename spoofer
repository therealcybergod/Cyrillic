def spoof_username(email):
    try:
        name, domain = email.split("@")
    except ValueError:
        print("Invalid email format. Please include an '@' symbol.")
        return
    print("\n[+] Generating spoofed variants of username...\n")
    spoofed = set()

    for i in range(len(name)):
        char = name[i].lower()
        if char in spoof_map:
            for variant in spoof_map[char]:
                spoofed_name = name[:i] + variant + name[i + 1:]
                spoofed.add(f"{spoofed_name}@{domain}")

    if spoofed:
        for variant in sorted(spoofed):
            print(variant)
    else:
        print("No spoof variants found for the given username.")

def detect_spoofed(email):
    try:
        name, _ = email.split("@")
    except ValueError:
        print("Invalid email format. Please include an '@' symbol.")
        return

    print("\n[+] Detecting non-ASCII homoglyphs in username...\n")
    suspicious_chars = [(char, unicodedata.name(char, "UNKNOWN"), f"U+{ord(char):04X}")
                        for char in name if not char.isascii()]
    if suspicious_chars:
        print(tabulate(suspicious_chars, headers=["Char", "Unicode Name", "Code Point"]))
    else:
        print("No suspicious Unicode characters found in the username.")

def display_unicode_table():
    print("\n[+] Unicode Table of Common Homoglyphs\n")
    table = []
    for base, variants in sorted(spoof_map.items()):
        for variant in variants:
            try:
                name = unicodedata.name(variant)
            except ValueError:
                name = "UNKNOWN"
            table.append([base, variant, f"U+{ord(variant):04X}", name])
    print(tabulate(table, headers=["Base Char", "Variant", "Code Point", "Unicode Name"], tablefmt="grid"))

